#!/bin/bash

prj=$(basename $PWD)
cmd=../docs-$prj
upgrade=$SMITHHOME/$prj/upgrade*.bash
# if [ -f requirements.txt ]
# then
#     pip3 install -r requirements.txt
# fi
if [ -x $cmd ]
then
    echo "now running $cmd"
    $cmd
elif [ -s $upgrade ]
then
    umask 022
    bash $upgrade
elif [ -f pyproject.toml -o -f setup.py ]
then
    python3 -m pip install --user -e .
    # vn python -m pip install -e .
elif [ -f wscript ]
then
    # put host
    rsync -a -v --delete source $HOME/guest/knuth
elif [ $HOSTNAME = "knuth" ]
then
    # put guest
    rsync -a -v source $HOME/knuth
else
    echo "unknown put workflow"
fi
