#!/bin/bash

umask 022
if [ ! -x /snap/bin/uv ]
then
    echo "Cannot find uv"
    exit 1
fi
sudo echo root

uv clean
uv venv -c --system-site-packages $HOME/smith
source $HOME/smith/bin/activate

locations=host
if [ $HOSTNAME = adobe -o $HOSTNAME = eliza ]
then
    locations=guest

    uv pip install toml flit packaging wheel tox Pillow urllib3 # setuptools
    sudo uv pip install --exclude-newer "37 days" --system --break-system-packages ninja meson

    uv pip install -r $SMITHHOME/requirements.txt
elif [ $HOSTNAME = knuth ]
then
    locations=special
fi

rustup update
rustup default nightly
#volta install node@latest

for level in 1 2 3 4 5 6 7 8 9 ''
do
    for location in all $locations
    do
        suffix=-$location
        if [ $location = all ]
        then
            suffix=''
        fi
        for upgrade in $SMITHHOME/*/upgrade${level}${suffix}.bash
        do
            if [ ! -f ${upgrade} ]
            then
                continue
            fi
            lib=$(dirname ${upgrade})
            src=$(basename ${lib})
            pushd ${src}
            put
            popd
        done
    done
done
sudo ldconfig

# Show build timestamps
pushd /dev/shm
ls -lt ~/builds/fontvalidator/bin /usr/local/bin/ ~/.cargo/bin
find /usr/local/lib -name fontforge* -exec ls -l {} \;
find /usr/local/lib -name psMat* -exec ls -l {} \;
popd

# Use the latest fontTools
uv pip show fonttools
