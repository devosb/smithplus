#!/bin/bash

prj=$(basename $PWD)

font=""
for cmd in ../rrun-$prj*
do
    if [ -x $cmd ]
    then
        echo "now running $cmd"
        $cmd
        font="found"
    fi
done

if [ -z "$font" ]
then
    dir=/mnt/builds/$prj
    if [ -d $dir ]
    then
        echo "now running rsync $dir"
        rsync -v -a --exclude target --delete $dir/ .
    elif [ -f wscript ]
    then
        # get host
        rsync -a -v $HOME/guest/knuth/source $PWD
        rsync -a -v --exclude source/productsite $HOME/guest/adobe/documentation $PWD
    elif [ -d references ]
    then
        ref=$PWD/references
        pushd $HOME/guest/adobe
        for ttf in *.ttf
        do
            if [ -f $ttf ]
            then
                rsync -v -a -R $ttf $ref
            fi
        done
        popd
        ls -l -t references/*.ttf
    elif [ $HOSTNAME = "knuth" ]
    then
        # get guest
        rsync -a -v --delete $HOME/knuth/source $HOME
        rsync -a -v --delete $HOME/knuth/fonts $HOME/.fonts
    else
        echo "unknown get workflow"
    fi
fi
